{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academie.okoho.de/schema/seance.schema.json",
  "title": "Métadonnées d'une séance · OKOHO Académie",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "partie", "module", "titre", "type", "outil", "appareil", "duree", "prerequis", "echafaudage", "acces_defaut", "livrable", "glossaire", "index", "videos", "version", "status"],
  "properties": {
    "code": {"type": "string", "pattern": "^M[0-9]{2}-S[0-9]$"},
    "partie": {"type": "string", "enum": ["I", "II", "III", "IV", "V"]},
    "module": {"type": "string", "pattern": "^M[0-9]{2}$"},
    "titre": {"type": "string", "minLength": 3},
    "type": {"type": "string", "enum": ["direct", "autonomie"]},
    "outil": {"type": "string", "minLength": 3},
    "appareil": {"type": "string", "enum": ["smartphone", "laptop-recommande", "laptop-obligatoire"]},
    "duree": {
      "type": "object", "additionalProperties": false, "required": ["seance", "devoir"],
      "properties": {"seance": {"type": "integer", "minimum": 0}, "devoir": {"type": "integer", "minimum": 0}}
    },
    "prerequis": {"type": "array", "items": {"type": "string", "pattern": "^M[0-9]{2}-S[0-9]$"}},
    "echafaudage": {"type": "integer", "minimum": 1, "maximum": 4},
    "acces_defaut": {"type": "string", "enum": ["libre", "verrouille", "programme", "prerequis", "jalon", "manuel"]},
    "jalon": {"type": "string", "enum": ["J1", "J2", "J3", "J4", "J5"]},
    "livrable": {"type": "string", "minLength": 3},
    "glossaire": {"type": "array", "items": {"type": "string"}},
    "index": {"type": "array", "items": {"type": "string"}},
    "videos": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "tutoriel": {"type": "boolean"}, "vitrine": {"type": "boolean"},
        "shorts": {"type": "integer", "minimum": 0, "maximum": 5}, "signature": {"type": "boolean"}
      }
    },
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "captures": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "status": {"type": "string", "enum": ["brouillon", "relecture", "valide"]}
  }
}
