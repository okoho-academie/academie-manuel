{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document d'accueil · OKOHO Académie",
  "description": "En-tête YAML des documents accueil/<CODE>/document.md (guides, diagnostic, kick-off).",
  "type": "object",
  "required": ["code", "titre", "type", "version", "public"],
  "additionalProperties": false,
  "properties": {
    "code": {"type": "string", "pattern": "^A00-[0-9]{2}$"},
    "titre": {"type": "string", "minLength": 3},
    "type": {"type": "string", "enum": ["document"]},
    "jalon": {"type": ["string", "null"], "enum": ["J1", "J2", "J3", "J4", "J5", null]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "captures": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "verifie": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Date de vérification des fonctions et prix de Claude cités"},
    "public": {"type": "string", "enum": ["apprenants", "formateur"]},
    "glossaire": {"type": "array", "items": {"type": "string"}},
    "index": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["brouillon", "valide"]}
  }
}
