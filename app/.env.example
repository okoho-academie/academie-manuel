# OKOHO Académie · Variables d'environnement
# Copier en .env.local pour le développement local
# Jamais de valeurs réelles dans ce fichier

# Supabase (Paramètres → API dans le tableau de bord Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Supabase service role (uniquement côté serveur, jamais exposé au navigateur)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Claude API (Anthropic Console → API keys)
ANTHROPIC_API_KEY=sk-ant-...

# E-mail (SMTP ou API — à configurer selon le fournisseur retenu)
EMAIL_FROM=academie@okoho.de
# Resend (recommandé, plan gratuit : 3 000 e-mails/mois, vérifié 2026-10)
RESEND_API_KEY=re_...

# Notifications push — clés VAPID (générer avec : npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BN...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:academie@okoho.de

# URL publique de l'application
NEXT_PUBLIC_APP_URL=https://academie.okoho.de
